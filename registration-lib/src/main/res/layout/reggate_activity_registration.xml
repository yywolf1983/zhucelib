<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reggate_dialog_bg"
    android:fillViewport="true"
    android:fadeScrollbars="false"
    android:scrollbarThumbVertical="@drawable/reggate_scrollbar_thumb"
    android:scrollbarStyle="outsideOverlay"
    android:scrollbarAlwaysDrawVerticalTrack="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:src="@android:drawable/ic_lock_lock"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/reggate_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/reggate_text_main"
            tools:ignore="HardcodedText"
            tools:text="激活 - 本应用" />

        <TextView
            android:id="@+id/reggate_tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#888888"
            tools:ignore="HardcodedText"
            tools:text="试用剩余 7 天" />

        <!-- ============ 卡片 1: 本机安装码 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="12dp"
            android:background="@drawable/reggate_bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reggate_request_code_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/reggate_tv_request_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="10dp"
                android:background="@drawable/reggate_bg_field"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/reggate_text_blue"
                tools:ignore="HardcodedText"
                tools:text="ABCD-EFGH-IJKL-MNOP-QRST-UVWX-YZ01-2345" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/reggate_btn_copy_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/reggate_bg_chip_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/reggate_ic_copy"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/reggate_text_blue"
                        android:textSize="12sp"
                        android:text="@string/reggate_copy_request" />
                </LinearLayout>

                    <View
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <LinearLayout
                        android:id="@+id/reggate_btn_request_qr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/reggate_bg_chip_blue"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/reggate_ic_qr"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/reggate_text_blue"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:text="@string/reggate_show_request_qr" />
                    </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 卡片 2: 激活码 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/reggate_bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reggate_activation_code_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#555555" />

            <EditText
                android:id="@+id/reggate_et_activation_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minLines="3"
                android:gravity="top|start"
                android:fontFamily="monospace"
                android:background="@drawable/reggate_bg_field"
                android:padding="10dp"
                android:hint="@string/reggate_activation_code_hint"
                android:textColorHint="#B0BEC5"
                android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/reggate_btn_paste"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/reggate_bg_chip_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:textColor="@color/reggate_text_blue"
                    android:textSize="12sp"
                    android:text="@string/reggate_paste" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:id="@+id/reggate_btn_scan_qr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/reggate_bg_chip_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/reggate_ic_scan_qr"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textColor="@color/reggate_text_blue"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="@string/reggate_scan_qr" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:id="@+id/reggate_btn_pick_qr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/reggate_bg_chip_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/reggate_ic_gallery"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textColor="@color/reggate_text_blue"
                        android:textSize="12sp"
                        android:text="@string/reggate_pick_qr" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/reggate_btn_activate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/reggate_bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:enabled="false"
                android:text="@string/reggate_activate" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:text="@string/reggate_how_to" />

        <LinearLayout
            android:id="@+id/reggate_contact_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/reggate_bg_card"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reggate_contact_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/reggate_contact_phone_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/reggate_tv_contact_phone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textColor="#555555" />
                <TextView
                    android:id="@+id/reggate_tv_contact_phone_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/reggate_text_blue"
                    android:text="@string/reggate_copy"
                    android:paddingLeft="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reggate_contact_email_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/reggate_tv_contact_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textColor="#555555" />
                <TextView
                    android:id="@+id/reggate_tv_contact_email_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/reggate_text_blue"
                    android:text="@string/reggate_copy"
                    android:paddingLeft="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reggate_contact_website_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/reggate_tv_contact_website"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textColor="#555555" />
                <TextView
                    android:id="@+id/reggate_tv_contact_website_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/reggate_text_blue"
                    android:text="@string/reggate_copy"
                    android:paddingLeft="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reggate_contact_shop_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/reggate_tv_contact_shop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:textColor="#555555" />
                <TextView
                    android:id="@+id/reggate_tv_contact_shop_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/reggate_text_blue"
                    android:text="@string/reggate_copy"
                    android:paddingLeft="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/reggate_tv_contact_custom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/reggate_iv_qr_code"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:contentDescription="@null" />

            <Button
                android:id="@+id/reggate_btn_save_qr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:minWidth="0dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textSize="12sp"
                android:visibility="gone"
                android:text="@string/reggate_save_qr" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
