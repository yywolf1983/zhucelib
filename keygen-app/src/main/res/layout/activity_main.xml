<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keygen_app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/keygen_subtitle"
            android:textSize="12sp"
            android:textColor="#888" />

        <!-- 私钥选择区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/kg_section_privkey"
            android:textStyle="bold"
            android:textColor="#1976D2" />

        <TextView
            android:id="@+id/tv_priv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="#666"
            tools:text="未选择私钥文件" />

        <Button
            android:id="@+id/btn_select_priv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/kg_select_priv" />

        <!-- 生成激活码区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/kg_section_gen"
            android:textStyle="bold"
            android:textColor="#1976D2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/kg_request_code_label"
            android:textSize="13sp"
            android:textColor="#555" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/kg_bg_card"
            android:orientation="vertical"
            android:padding="10dp">

            <EditText
                android:id="@+id/et_request_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kg_bg_field"
                android:fontFamily="monospace"
                android:hint="@string/kg_request_code_hint"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:padding="10dp"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_paste_request"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="38dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:text="@string/kg_paste_request"
                    android:textSize="12sp"
                    app:icon="@drawable/kg_ic_paste"
                    app:iconGravity="textStart"
                    app:iconPadding="3dp"
                    app:iconSize="16dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btn_scan_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="38dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:text="@string/kg_scan_request"
                    android:textSize="12sp"
                    app:icon="@drawable/kg_ic_scan"
                    app:iconGravity="textStart"
                    app:iconPadding="3dp"
                    app:iconSize="16dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btn_pick_request_qr"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="38dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:text="@string/kg_pick_request_qr"
                    android:textSize="12sp"
                    app:icon="@drawable/kg_ic_gallery"
                    app:iconGravity="textStart"
                    app:iconPadding="3dp"
                    app:iconSize="16dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 设备总览 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="设备总览"
            android:textStyle="bold"
            android:textColor="#1976D2" />

        <TextView
            android:id="@+id/tv_device_overview_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="#AAA"
            android:visibility="gone"
            tools:text="1 个设备 · 3 个包 · 共 5 条记录" />

        <LinearLayout
            android:id="@+id/ll_device_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/kg_valid_days_label"
            android:textSize="13sp"
            android:textColor="#555" />

        <EditText
            android:id="@+id/et_valid_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:hint="@string/kg_valid_days_hint"
            android:inputType="number"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="@string/kg_generate" />

        <TextView
            android:id="@+id/tv_package_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:textColor="#555"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="com.example.app · 设备: A1B2C3D4E5F6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/kg_activation_code_label"
            android:textSize="13sp"
            android:textColor="#555" />

        <TextView
            android:id="@+id/tv_activation_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="10dp"
            android:background="@drawable/kg_bg_code_box"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="10sp"
            android:textColor="#1565C0"
            tools:text="ABCDE-FGHIJ-KLMNO-PQRST-..." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_valid_days_result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="10dp"
                android:textSize="12sp"
                android:textColor="#E65100"
                tools:text="购买时长: 365 天" />

            <TextView
                android:id="@+id/tv_expiry_result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingRight="10dp"
                android:gravity="right"
                android:textSize="12sp"
                android:textColor="#388E3C"
                tools:text="到期: 2025-07-08" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_copy_activation"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:enabled="false"
            android:text="@string/kg_copy_activation" />

        <!-- 激活码二维码(生成成功后显示) -->
        <ImageView
            android:id="@+id/iv_activation_qr"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/kg_bg_qr_frame"
            android:padding="8dp"
            android:visibility="gone"
            android:contentDescription="@string/kg_activation_qr" />

        <TextView
            android:id="@+id/tv_activation_qr_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/kg_activation_qr_caption"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save_qr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="40dp"
                android:text="@string/kg_save_qr"
                android:textSize="12sp"
                app:icon="@drawable/kg_ic_qr_save"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/btn_share_qr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="40dp"
                android:text="@string/kg_share_qr"
                android:textSize="12sp"
                app:icon="@drawable/kg_ic_qr_share"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp" />
        </LinearLayout>

        <!-- 注册记录区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/kg_section_records"
            android:textStyle="bold"
            android:textColor="#1976D2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_record_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="#666"
                tools:text="共 0 个设备注册记录" />

            <Button
                android:id="@+id/btn_storage_settings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kg_storage_settings"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_storage_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="11sp"
            android:textColor="#AAA"
            tools:text="默认: /storage/emulated/0/..." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_view_records"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/kg_view_records" />

            <View android:layout_width="8dp" android:layout_height="0dp" />

            <Button
                android:id="@+id/btn_export_records"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/kg_export_records" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
